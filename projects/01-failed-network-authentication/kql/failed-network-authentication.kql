// Detects failed Windows authentication attempts (Event ID 4625)
// and filters for network-based logons (Logon Type 3).
// Extracts the targeted account, source IP address, and failure reason
// to support investigation of potential unauthorized access attempts.

Event
| where EventID == 4625
| extend LogonType = extract(@"Logon Type:\s+(\d+)", 1, RenderedDescription)
| extend TargetAccount = extract(@"Account For Which Logon Failed:.*?Account Name:\s+([^\s]+)", 1, RenderedDescription)
| extend SourceIP = extract(@"Source Network Address:\s+([^\s]+)", 1, RenderedDescription)
| extend FailureReason = extract(@"Failure Reason:\s+([^\r\n]+)", 1, RenderedDescription)
| where LogonType == "3"
| project TimeGenerated, Computer, TargetAccount, LogonType, SourceIP, FailureReason
